        {
          "name": "Paginado (defaults page=0 size=10 sort=id direction=desc)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no máximo 10 itens', () => pm.expect(body.length).to.be.at.most(10));",
                  "pm.test('ids em ordem desc', () => {",
                  "  for (let i = 1; i < body.length; i++) pm.expect(body[i-1].id).to.be.above(body[i].id);",
                  "});",
                  "pm.test('a mais recente vem primeiro', () => pm.expect(body[0].id).to.eql(Number(pm.collectionVariables.get('categoriaId2'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categoria/paginado"
          }
        },
        {
