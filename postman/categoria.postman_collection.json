                  "pm.test('no máximo 2 itens', () => pm.expect(body.length).to.be.at.most(2));",
                  "pm.test('nomes em ordem asc', () => {",
                  "  for (let i = 1; i < body.length; i++) pm.expect(body[i-1].nome.localeCompare(body[i].nome, 'pt-BR')).to.be.at.most(0);",
                  "});"
