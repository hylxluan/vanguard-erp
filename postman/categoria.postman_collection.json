{
  "info": {
    "name": "VanguardERP - Categoria",
    "description": "Testes dos endpoints de /api/categoria. Rode a collection inteira em ordem: o 'Auth / Login' salva o token em {{token}} e o 'Fluxo CRUD' cria, consulta, atualiza e apaga as próprias categorias (nomes únicos por execução), então pode ser rodada várias vezes sem sujar o banco. Usuários de teste do V1__init.sql, senha: sport clube do recife.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/vanguard-erp"
    },
    {
      "key": "login",
      "value": "maria.silva@ajsolucoes.com.br"
    },
    {
      "key": "senha",
      "value": "sport clube do recife"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "nomeCategoria",
      "value": ""
    },
    {
      "key": "nomeCategoria2",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "categoriaId2",
      "value": ""
    },
    {
      "key": "empresaId",
      "value": ""
    },
    {
      "key": "qtdListar",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "url": "{{baseUrl}}/api/usuario/login"
          }
        }
      ]
    },
    {
      "name": "Fluxo CRUD",
      "item": [
        {
          "name": "Cadastrar",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Date.now();",
                  "pm.collectionVariables.set('nomeCategoria', 'Postman Categoria ' + sufixo);",
                  "pm.collectionVariables.set('nomeCategoria2', 'Postman Outra ' + sufixo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('retorna id, nome e empresaId', () => {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.nome).to.eql(pm.collectionVariables.get('nomeCategoria'));",
                  "  pm.expect(body.empresaId).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('categoriaId', body.id);",
                  "pm.collectionVariables.set('empresaId', body.empresaId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeCategoria}}\"\n}"
            },
            "url": "{{baseUrl}}/api/categoria/cadastrar"
          }
        },
        {
          "name": "Cadastrar segunda categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('categoriaId2', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeCategoria2}}\"\n}"
            },
            "url": "{{baseUrl}}/api/categoria/cadastrar"
          }
        },
        {
          "name": "Cadastrar nome duplicado (maiúsculo) -> 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nomeMaiusculo', pm.collectionVariables.get('nomeCategoria').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('mensagem de duplicado', () => pm.expect(pm.response.json().message).to.include('mesmo nome'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeMaiusculo}}\"\n}"
            },
            "url": "{{baseUrl}}/api/categoria/cadastrar"
          }
        },
        {
          "name": "Buscar por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('é a categoria cadastrada', () => {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('categoriaId')));",
                  "  pm.expect(body.nome).to.eql(pm.collectionVariables.get('nomeCategoria'));",
                  "  pm.expect(body.empresaId).to.eql(Number(pm.collectionVariables.get('empresaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categoria/buscarPorId/{{categoriaId}}"
          }
        },
        {
          "name": "Buscar por nome (trecho, minúsculo)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const nome = pm.collectionVariables.get('nomeCategoria');",
                  "pm.variables.set('trechoNome', nome.substring(9).toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = Number(pm.collectionVariables.get('categoriaId'));",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('encontra a categoria', () => pm.expect(body.map(c => c.id)).to.include(id));",
                  "pm.test('não traz a segunda categoria', () => pm.expect(body.map(c => c.id)).to.not.include(Number(pm.collectionVariables.get('categoriaId2'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categoria/buscarPorNome?nome={{trechoNome}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categoria",
                "buscarPorNome"
              ],
              "query": [
                {
                  "key": "nome",
                  "value": "{{trechoNome}}"
                }
              ]
            }
          }
        },
        {
          "name": "Listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const ids = body.map(c => c.id);",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('contém as duas categorias', () => {",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('categoriaId')));",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('categoriaId2')));",
                  "});",
                  "pm.test('só categorias da empresa logada', () => body.forEach(c => pm.expect(c.empresaId).to.eql(Number(pm.collectionVariables.get('empresaId')))));",
                  "pm.collectionVariables.set('qtdListar', body.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categoria/listar"
          }
        },
        {
          "name": "Total",
